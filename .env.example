PROJECT_NAME="Analog Terrax API"
VERSION="0.1.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# CORS configuration
CORS_ORIGINS=["http://localhost:3000","https://analog-terrax.vercel.app"]
CORS_ORIGIN_REGEX="^https://analog-terrax-frontend.*\\.vercel\\.app$"

# Vercel Web Analytics
ENABLE_WEB_ANALYTICS=true

# Upstream HTTP & NASA API configuration
UPSTREAM_TIMEOUT_SECONDS=15.0
NASA_API_KEY="DEMO_KEY"
NASA_API_BASE_URL="https://api.nasa.gov"
